# TravelMate Environment Configuration
# 개발용 환경변수 파일 (실제 값으로 교체 필요)

# Firebase Configuration
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_PROJECT_ID=travelmate-project
FIREBASE_MESSAGING_SENDER_ID=123456789
FIREBASE_APP_ID=1:123456789:android:abcd1234

# API Endpoints
BASE_API_URL=https://api.travelmate.com
DIALOGFLOW_PROJECT_ID=travelmate-ai
GOOGLE_MAPS_API_KEY=your-google-maps-key

# Payment Configuration
IAMPORT_USER_CODE=your-iamport-code
BOOTPAY_APPLICATION_ID=your-bootpay-app-id
BOOTPAY_PRIVATE_KEY=your-bootpay-private-key

# Third Party Services
SOCKET_SERVER_URL=wss://socket.travelmate.com
ML_KIT_API_KEY=your-ml-kit-key

# Environment
ENVIRONMENT=development
DEBUG_MODE=true